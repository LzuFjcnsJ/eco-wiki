---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/ParticleField.astro';
import FloatingRocks from '../components/FloatingRocks.astro';
import { withBase } from '../lib/url';

const docs = (await getCollection('docs')).sort((a, b) => a.data.chapter - b.data.chapter);

const GROUP_META = [
  { key: 'core', label: '核心技能' },
  { key: 'workflow', label: '流程与规范' },
  { key: 'reference', label: '参考与元信息' },
];

const groups = GROUP_META.map((meta) => ({
  ...meta,
  docs: docs.filter((doc) => doc.data.group === meta.key),
})).filter((group) => group.docs.length > 0);

/** Deep links to the sections people actually open the site for. */
const quickJumps = [
  { label: '相机参数速查', href: '/wiki/photography/#参数速查表' },
  { label: '发表前检查清单', href: '/wiki/publishing/#发表前检查清单' },
  { label: '排版规则速查卡', href: '/wiki/layout/#排版规则速查卡' },
  { label: '催稿话术', href: '/wiki/collaboration/#跨部门沟通话术' },
  { label: '照片命名规范', href: '/wiki/photography/#照片命名规范' },
  { label: '新人第一周', href: '/wiki/first-week/' },
];

const legacy = (await getCollection('legacy'))
  .slice()
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2);

const statusLabel: Record<string, string> = {
  stable: '已定稿',
  review: '待复核',
  draft: '草稿',
};
---

<BaseLayout title="首页" pageKey="home">
  <section class="hero hero--compact">
    <ParticleField count={96} color="#20E5B5" />
    <FloatingRocks />
    <span class="hero__streak" aria-hidden="true"></span>

    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">生态学院团委宣传部 · 教程站</p>

      <h1 class="hero__title">
        写稿、拍照、排版，<span class="u-accent">规矩</span>都在这儿。
      </h1>

      <p class="hero__lede">
        所有规范、参数和话术都在这个站里。直接搜关键词跳到那一节 —— 比在群里等人回复快。
      </p>

      <div class="hero-search" id="hero-search">
        <div class="hero-search__box">
          <div class="hero-search__field">
            <svg class="hero-search__glyph" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <circle cx="7.2" cy="7.2" r="5.2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M11.2 11.2L15 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <input
              type="search"
              id="hero-search-input"
              placeholder="搜「ISO」「原创」「催稿」「红线」…"
              autocomplete="off"
              spellcheck="false"
              aria-label="搜索教程内容"
              aria-controls="hero-search-results"
            />
            <kbd>/</kbd>
          </div>
          <div class="hero-search__results" id="hero-search-results" role="listbox" hidden></div>
        </div>
        <p class="hero-search__hint">
          <span>↑↓ 选择</span>
          <span>Enter 打开</span>
          <span id="hero-search-count">载入索引…</span>
        </p>
      </div>

      <nav class="quick-jump" aria-label="高频速查">
        <span class="quick-jump__label">高频速查</span>
        {
          quickJumps.map((jump) => (
            <a href={withBase(jump.href)} data-cursor="link" data-cursor-label="跳转">
              {jump.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section" aria-labelledby="chapters-heading">
    <div class="shell">
      <header class="section__head">
        <div>
          <p class="eyebrow">全部内容 · {docs.length} 篇</p>
          <h2 class="section__title" id="chapters-heading">章节目录</h2>
        </div>
        <a class="btn btn--ghost" href={withBase('/wiki/')} data-cursor="link">
          按分类浏览
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </header>

      {
        groups.map((group) => (
          <div class="doc-group">
            <div class="group-head">
              <span class="group-head__label">{group.label}</span>
              <span class="group-head__rule" aria-hidden="true" />
              <span class="tagline">{group.docs.length} 章</span>
            </div>

            <div class="doc-list">
              {group.docs.map((doc) => (
                <a class="doc-row" href={withBase(`/wiki/${doc.id}/`)} data-cursor="card" data-cursor-label="阅读">
                  <span class="doc-row__num">{String(doc.data.chapter).padStart(2, '0')}</span>
                  <span>
                    <span class="doc-row__title">
                      <span class="doc-row__icon" aria-hidden="true">{doc.data.icon}</span>
                      {doc.data.title}
                    </span>
                    <span class="doc-row__summary">{doc.data.summary}</span>
                  </span>
                  <span class="doc-row__meta">
                    <span class={`pill pill--${doc.data.status}`}>{statusLabel[doc.data.status]}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="legacy-heading">
    <div class="shell">
      <div class="legacy-teaser">
        <div>
          <p class="eyebrow">Digital legacy</p>
          <h2 class="legacy-teaser__title" id="legacy-heading">每一届，留一句话</h2>
          <p class="legacy-teaser__note">
            上面的规范回答「怎么做」，这个档案记的是「为什么」。
            它按年份往后排，每一届在任时写、毕业后再补 —— 只要宣传部还在，它就会一直长下去。
          </p>
          <p style="margin-top:var(--s-5)">
            <a class="btn btn--ghost" href={withBase('/legacy/')} data-cursor="link">
              进入档案
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>

        <div class="legacy-teaser__list">
          {
            legacy.map((entry) => (
              <a class="legacy-teaser__item" href={withBase(`/legacy/#${entry.id}`)} data-cursor="link" data-cursor-label="查看">
                <span class="legacy-teaser__lesson">「{entry.data.lesson}」</span>
                <span class="legacy-teaser__who">
                  {entry.data.name} · {entry.data.role} · {entry.data.cohort}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="wiki-heading">
    <div class="shell shell--narrow">
      <div class="note-strip">
        <span class="note-strip__icon" aria-hidden="true">✎</span>
        <p class="note-strip__text">
          这个站是可协作的：每篇文章就是一个 Markdown 文件，放在
          <code>src/content/docs/</code> 里。新增文件后，目录、搜索索引、上一篇
          / 下一篇会自动更新，不需要改任何代码。
        </p>
        <a class="btn btn--ghost" href={withBase('/wiki/maintaining-the-wiki/')} data-cursor="link">看维护指南</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/effects.js';
</script>
